{
  "name": "manuale",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "concurrently -k -s first \"npm run dev\" \"electron .\"",
    "package": "npm run build && electron-builder build --win --dir",
    "dist": "npm run build && electron-builder build --win",
    "pack-simple": "npm run build && npx -y electron-packager . ManualeIT --platform=win32 --arch=x64 --out=dist-packager --overwrite",
    "pack-linux": "npm run build && npx -y electron-packager . ManualeIT --platform=linux --arch=x64 --out=dist-packager --overwrite",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.it.troubleshooting.manual",
    "productName": "ManualeRisoluzioneIT",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
